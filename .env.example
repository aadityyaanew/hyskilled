# ==============================================================================
# Hyskilled Web Storefront - Environment Variables
# Copy to `.env.local` and fill in real values. Never commit real secrets.
# ==============================================================================

# Site URL (Canonical metadata, sitemaps, OpenGraph, OAuth redirect base)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment Gateway Configuration
# Options: 'sandbox' | 'razorpay' | 'stripe'
# 'sandbox' enables the interactive test checkout dialog for local development without API keys.
NEXT_PUBLIC_PAYMENT_PROVIDER=sandbox

# Razorpay (Live or Test key)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# Stripe (Publishable key)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Analytics / Measurement ID (Optional)
NEXT_PUBLIC_GA_ID=

# ── MySQL database (raw SQL via mysql2 — no ORM) ──────────────────────────────
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Sessions ─────────────────────────────────────────────────────────────────
# Long random string (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ── Google OAuth (customer login) ─────────────────────────────────────────────
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Admin panel (/admin) — single admin account ──────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
